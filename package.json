{
  "name": "omp-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for the omp coding agent, powered by the Agent Client Protocol",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean:dist && npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "check": "npm run lint && npm run format:check && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^25.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@10.9.7"
}
